
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#

/reference:..\MonoJ.dll

#---------------------------------- Content ---------------------------------#

#begin audio/Desktop/Master.bank
/copy:audio/Desktop/Master.bank;audio/Desktop/Master

#begin audio/Desktop/Master.strings.bank
/copy:audio/Desktop/Master.strings.bank;audio/Desktop/Master.strings

#begin audio/GUIDs.txt
/copy:audio/GUIDs.txt

#begin barks.yaml
/copy:barks.yaml

#begin Codepage.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyColor=0,0,0,255
/processorParam:ColorKeyEnabled=True
/processorParam:GenerateMipmaps=False
/processorParam:PremultiplyAlpha=True
/processorParam:ResizeToPowerOfTwo=False
/processorParam:MakeSquare=False
/processorParam:TextureFormat=Color
/build:Codepage.png

#begin crt.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/build:crt.fx

